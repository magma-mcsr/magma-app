<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store build. Name, Publisher and PublisherDisplayName are assigned by the Store. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="MagmaMCSR.MagmaMCSR" Publisher="CN=2E1F736D-2EC8-4067-A07A-F5F9DB23BBEF" Version="1.2.2.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Magma MCSR</DisplayName>
    <PublisherDisplayName>Magma MCSR</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 11: WebView2 is part of the system there. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="magma-app.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Magma MCSR"
        Description="Saves your MCSR Ranked replays and sends them to Magma for analysis."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows": on after the first run, and Windows keeps the setting. -->
        <desktop:Extension Category="windows.startupTask" Executable="magma-app.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MagmaStartup" Enabled="true" DisplayName="Magma MCSR" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
