{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magma MCSR",
  "version": "0.2.2",
  "identifier": "com.magmamcsr.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://minotar.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNzI5Mzc2MUYyQkQxM0IKUldRNzBTc2ZkcE55U3JzZVRkZFA3c2pHUmRiQWZBMEZtRDBaU3ZPanViRFg4Y3pjSTJkY3phUmYK",
      "endpoints": [
        "https://github.com/magma-mcsr/magma-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
